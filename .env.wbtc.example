# WBTC carry bot (apps/wbtc). Copy to .env.wbtc. Never reuse the ETH bot's wallet or API key:
# the perps account is cross-margin, so the two strategies must not share it.

# Phase 1, read-only tracker: nothing below is required. Leave WALLET_ADDRESS empty.
KATANA_RPC_URL=https://rpc.katana.network
KATANA_RPC_FALLBACK_URLS=https://katana.drpc.org
DB_PATH=data/wbtc/wbtc.db
LOG_DIR=data/wbtc/logs
TRACK_INTERVAL_MIN=15
# Deposit size the tracker models (Sushi cost of its slice), USD
TRACK_DEPOSIT_USD=1000

# Alerts (send-only; the ETH bot owns Telegram commands, so the same bot token is fine)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PREFIX=[WBTC]

# Phase 2, pilot: new strategy wallet + its own Katana Perps API key (read, trade, withdraw scopes)
WALLET_ADDRESS=
KP_API_KEY=
KP_API_SECRET=
# WALLET_PRIVATE_KEY=0x...
WATCH_INTERVAL_MIN=5
RISK_CHECK_INTERVAL_SEC=15
# true = watch executes rebalances itself; false = alerts only
AUTO_REBALANCE=false
MAX_AUTO_REBALANCES_PER_DAY=6
PROTECTIVE_STOP=true
STOP_BELOW_LIQ_PCT=5

# Sizing (Config A): 40% LTV on all collateral, slice hedged at 3.3x
TARGET_LTV_PCT=40
TARGET_PERP_LEVERAGE=3.3
# Kind 1 bands: move USDC between Morpho and the perp account outside these
MIN_PERP_LEVERAGE=2.5
MAX_PERP_LEVERAGE=4.5
MIN_LTV_PCT=30
MAX_LTV_PCT=50
# Kind 2: resize the slice when it is this % off target; re-hedge when legs are this % apart
SLICE_BAND_PCT=15
DELTA_BAND_PCT=2

# Rate guards: halve the slice after SHRINK_AFTER_HOURS at or above SHRINK, grow back below RESUME, unwind at UNWIND
SHRINK_BORROW_APY_PCT=7
SHRINK_AFTER_HOURS=24
RESUME_BORROW_APY_PCT=5
UNWIND_BORROW_APY_PCT=10
BORROW_CEILING_PCT=4
MAX_NEGATIVE_FUNDING_PERIODS=3

# Liquidation ladder
RETRY_PERP_LEVERAGE=6.2
SHRINK_PERP_LEVERAGE=9.8
SHRINK_LTV_PCT=60
UNWIND_LTV_PCT=70

# Execution
MAX_CHUNK_USD=250
MAX_SLIPPAGE_BPS=50
MAX_SPOT_IMPACT_PCT=0.8
WITHDRAW_LTV_CAP_PCT=78
WITHDRAWAL_WAIT_SEC=180
MIN_TRADE_USD=5
WALLET_RESERVE_USD=0
COMPOUND_MIN_USD=25
COMPOUND_EVERY_DAYS=7
