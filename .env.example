# Phase 1 (read-only tracker) — no private key needed
WALLET_ADDRESS=0x...
KP_API_KEY=
KP_API_SECRET=
KATANA_RPC_URL=https://rpc.katana.network
# Backups, comma-separated, tried in order when the primary fails or rate-limits (empty = none)
KATANA_RPC_FALLBACK_URLS=https://katana.drpc.org
DB_PATH=data/bot.db
WATCH_INTERVAL_MIN=5

# Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_LEVERAGE=3
ALERT_DELTA_PCT=2
URGENT_DELTA_PCT=5
ALERT_BASIS_PCT=0.5

# Trading (enter / exit / hedge / deposit / withdraw). Must be the key for WALLET_ADDRESS.
# WALLET_PRIVATE_KEY=0x...
TARGET_LEVERAGE=2
RESERVE_PCT=5
MAX_CHUNK_USD=250
MAX_SLIPPAGE_BPS=30
MAX_SPOT_IMPACT_PCT=0.5

# Swap routing: "direct" = 0.05% vbUSDC/vbETH pool only (fine on the public RPC); "search" = all fee tiers + two-hop (needs a keyed RPC)
SWAP_ROUTING=direct

# Rebalancer bands
MIN_LEVERAGE=1.5
MAX_LEVERAGE=2.5
REBALANCE_BAND_PCT=10
MIN_TRADE_USD=5
# Withdraw needs an API key with Withdraw scope
ALLOW_WITHDRAW=false
# true = watch executes rebalances itself; false = alerts only
AUTO_REBALANCE=false
# Auto mode pauses itself after this many rebalances in 24h
MAX_AUTO_REBALANCES_PER_DAY=6
MIN_GROW_FUNDING_RATE=0.00005
AVG_FUNDING_PERIODS=6

# Fast perp-only risk check between full checks (seconds)
RISK_CHECK_INTERVAL_SEC=15
# Reduce-only stop on the exchange, this % under the liquidation price (maintained in auto mode)
PROTECTIVE_STOP=true
STOP_BELOW_LIQ_PCT=15
